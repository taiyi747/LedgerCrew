APP_NAME=LedgerCrew API
FRONTEND_ORIGIN=http://127.0.0.1:3210
ENVIRONMENT=development
DEV_OWNER_USER_IDS=["owner"]
ADMIN_USERNAME=owner
ADMIN_PASSWORD=junctionchina2026nb
WORKER_ENABLED=true
DATABASE_URL=sqlite+aiosqlite:///./ledgercrew.db
SQL_ECHO=false
STORAGE_ROOT=./storage_data
MAX_UPLOAD_FILES=20
MAX_IMAGE_BYTES=5242880
MAX_CSV_BYTES=2097152
MAX_ARCHIVE_BYTES=26214400
MAX_ARCHIVE_FILES=30
MAX_ARCHIVE_ENTRY_BYTES=5242880
MAX_ARCHIVE_TOTAL_BYTES=52428800
MAX_ARCHIVE_RATIO=100
CSV_MAX_ROWS=200
CSV_DATE_FORMAT=%Y-%m-%d
SSE_POLL_SECONDS=1.0
SSE_HEARTBEAT_SECONDS=15.0
CSV_COLUMN_MAP={"transaction_date":"transaction_date","counterparty":"counterparty","direction":"direction","amount":"amount","description":"description","external_id":"external_id"}

# MiMo agent workflow (local credentials only)
MIMO_API_KEY=replace-with-your-key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL_PRO=mimo-v2.6-pro
MIMO_MODEL_FLASH=mimo-v2.6-flash
MIMO_TIMEOUT_SECONDS=60
MIMO_TRANSIENT_RETRIES=2
MIMO_OUTPUT_RETRIES=2
MIMO_MAX_REQUESTS=64
LEDGERCREW_DATA_DIR=data
