{
  "operation": "POST /api/v1/auth/login | POST /api/v1/auth/logout | GET /api/v1/auth/me",
  "note": "v0.2 认证接口示例（DEC-013 pending）。credential 是提供者定义的不透明认证状态，开发环境值不代表任何生产机制；生产环境所有认证接口返回 503。refresh 为 proposed，未实现未挂载。",
  "headers": {
    "credential": "Authorization: <scheme> <value>（登录响应 credential.scheme + ' ' + credential.value）",
    "dev_user_id_legacy": "X-User-Id: <user_id>（MVP 开发模拟，仅业务接口；/auth/me 不接受）"
  },
  "login_request": {
    "email": "demo@example.com",
    "password": "example-password"
  },
  "login_success": {
    "status": 200,
    "body": {
      "user": {
        "user_id": "demo",
        "email": "demo@example.com"
      },
      "credential": {
        "scheme": "DevSession",
        "value": "3hK0mZ1pQ7wXaB9cD2eF5gH8jK1lN4mP7qR0sT3uV6w",
        "expires_at": "2026-11-07T13:00:00Z"
      }
    }
  },
  "login_invalid_credentials": {
    "status": 401,
    "body": {
      "error": {
        "code": "unauthorized",
        "message": "Invalid email or password"
      }
    },
    "note": "邮箱未注册与密码错误返回完全相同；前端不得提示'邮箱未注册'。"
  },
  "validation_error": {
    "status": 422,
    "body": {
      "error": {
        "code": "validation_error",
        "message": "Invalid request"
      }
    },
    "note": "email 格式非法、密码缺失/空白、未知字段均返回此响应。"
  },
  "logout_request": {
    "headers": {
      "Authorization": "DevSession 3hK0mZ1pQ7wXaB9cD2eF5gH8jK1lN4mP7qR0sT3uV6w"
    }
  },
  "logout_success": {
    "status": 200,
    "body": {
      "status": "logged_out"
    },
    "note": "认证状态已被真实撤销；同一凭据后续请求返回 401。"
  },
  "logout_invalid_state": {
    "status": 401,
    "body": {
      "error": {
        "code": "unauthorized",
        "message": "Authentication required"
      }
    },
    "note": "无效或过期凭据不做假成功；前端应清理本地凭据并回到登录页。"
  },
  "me_success": {
    "status": 200,
    "body": {
      "user_id": "demo",
      "email": "demo@example.com"
    },
    "note": "身份由服务端验证；不返回角色/租户字段（待 DEC-013/DEC-010）。"
  },
  "me_unauthorized": {
    "status": 401,
    "body": {
      "error": {
        "code": "unauthorized",
        "message": "Authentication required"
      }
    },
    "note": "缺失、格式非法、伪造或过期凭据统一 401。"
  },
  "production_gate": {
    "status": 503,
    "body": {
      "error": {
        "code": "authentication_unavailable",
        "message": "Production authentication is not configured"
      }
    },
    "note": "生产环境 login/logout/me 一律 503（DEC-013 确认前保持门禁）。"
  }
}
